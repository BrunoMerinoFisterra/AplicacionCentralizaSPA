# Azure SQL (mismo servidor que FSTrack — las tablas propias son centraliza_*)
DB_SERVER=
DB_USER=
DB_PASSWORD=
DB_NAME=
# DB_PORT=1433

# Secreto propio de Centraliza (NO reusar el de fstrack-api)
JWT_SECRET=

# Credenciales OAuth de Finnegans del cliente Centraliza SPA
FINNEGANS_CLIENT_ID=
FINNEGANS_CLIENT_SECRET=

# Tope global de empresas habilitadas (códigos de Finnegans separados por coma).
# Ningún usuario puede ver ni operar otra empresa, aunque tenga otra asignación.
# Vacío o sin definir = sin tope (se usan solo las asignaciones por usuario).
# 16 = "Centraliza Spa"  (82 = "Centraliza SpA", deshabilitada)
ALLOWED_COMPANY_CODES=16

PORT=3002
